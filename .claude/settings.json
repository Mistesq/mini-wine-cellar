{
  "enabledMcpjsonServers": [
    "context7",
    "playwright"
  ],
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm exec -w web -- tsc --noEmit:*)",
      "Bash(npm exec -w web -- next typegen:*)",
      "Bash(npm exec -w api -- tsc --noEmit:*)",
      "Bash(npm exec -w api -- mikro-orm:*)",
      "Bash(npx mikro-orm:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./apps/*/.env)",
      "Read(./apps/*/.env.local)",
      "Read(./apps/*/.env.development)",
      "Read(./apps/*/.env.production)",
      "Read(./apps/*/.env.test)"
    ]
  }
}
