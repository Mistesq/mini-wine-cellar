{
  "name": "mini-wine-cellar",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "version": "1.0.0",
  "scripts": {
    "build:shared": "npm run build -w @mini-wine-cellar/shared",
    "prepare": "npm run build:shared",
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run start:dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "concurrently": "^10.0.6"
  }
}
